{
  "name": "obsidian-zotero-assistant",
  "version": "4.2.1",
  "description": "Import Zotero references, notes, and PDF annotations in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check-types": "tsc --noemit",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src/**/* --fix",
    "prettier": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "clean": "npm run prettier && npm run lint:fix",
    "test": "jest",
    "bump": "node version-bump.mjs",
    "release": "node .github/scripts/release.mjs verify",
    "test:citation": "jest --runInBand --runTestsByPath src/bbt/tests/cayw.test.ts src/bbt/tests/citationLinks.test.ts"
  },
  "keywords": [],
  "author": "Randy Allen",
  "authorUrl": "https://github.com/RandyAllenEEE",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "7.22.5",
    "@babel/preset-typescript": "7.22.5",
    "@codemirror/language": "git+https://github.com/lishid/cm-language.git#9ac00a8d951eafe333e567db552a3d04b461f435",
    "@types/jest": "29.5.2",
    "@types/lru-cache": "^7.10.10",
    "@types/node": "20.3.3",
    "@types/nunjucks": "3.2.3",
    "@types/react-dom": "18.2.6",
    "@types/tar-stream": "^3.1.4",
    "@types/which": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "5.61.0",
    "@typescript-eslint/parser": "5.61.0",
    "babel-jest": "29.5.0",
    "builtin-modules": "3.3.0",
    "esbuild": "^0.28.2",
    "escape-string-regexp": "^5.0.0",
    "eslint": "8.44.0",
    "eslint-plugin-react": "7.32.2",
    "jest": "29.5.0",
    "jest-environment-jsdom": "29.7.0",
    "moment": "2.31.0",
    "obsidian": "1.2.8",
    "prettier": "2.8.8",
    "tslib": "2.6.0",
    "typescript": "5.1.6",
    "xml-js": "1.6.11"
  },
  "dependencies": {
    "escape-path-with-spaces": "1.0.2",
    "execa": "7.1.1",
    "fflate": "0.8.3",
    "fuse.js": "6.6.2",
    "i18next": "^26.0.5",
    "nunjucks": "3.2.4",
    "preact": "10.15.1",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat",
    "react-i18next": "^17.0.3",
    "react-json-tree": "0.18.0",
    "react-select": "5.7.3",
    "shell-path": "^3.0.0",
    "tar-stream": "3.2.2",
    "which": "^3.0.1"
  },
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    }
  }
}
